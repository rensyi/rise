{
  "expo": {
    "name": "Rise",
    "slug": "rise",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rensyi.rise"
    },
    "android": {
      "package": "com.rensyi.rise",
      "adaptiveIcon": {
        "backgroundColor": "#161210",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-localization",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D0A215"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 288,
          "backgroundColor": "#161210"
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/rubik/400Regular/Rubik_400Regular.ttf",
            "./node_modules/@expo-google-fonts/rubik/500Medium/Rubik_500Medium.ttf"
          ],
          "widgets": [
            {
              "name": "RiseLog",
              "label": "Rise: I'm up",
              "description": "Log your wake-up with one tap",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget-preview-log.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "RiseWeek",
              "label": "Rise: streak",
              "description": "Your streak and the last seven days",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget-preview-week.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3a641120-7461-4f6f-a4db-ed33c09eb122"
      }
    }
  }
}
